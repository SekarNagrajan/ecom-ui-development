<?xml version="1.0" encoding="UTF-8"?>
<web-app version="3.1"
    xmlns="http://xmlns.jcp.org/xml/ns/javaee"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd">
    <context-param>
        <param-name>javax.faces.PROJECT_STAGE</param-name>
        <param-value>Development</param-value>
    </context-param>
    <listener>
        <description>ServletContextListener</description>
        <listener-class>net.ecom.Initialization.ApplicaitionInit</listener-class>
    </listener>
    <servlet>
        <servlet-name>action</servlet-name>
        <servlet-class>org.apache.struts.action.ActionServlet</servlet-class>
        <init-param>
            <param-name>config</param-name>
            <param-value>/WEB-INF/struts-config.xml</param-value>
        </init-param>
        <init-param>
            <param-name>debug</param-name>
            <param-value>2</param-value>
        </init-param>
        <init-param>
            <param-name>detail</param-name>
            <param-value>2</param-value>
        </init-param>
        <load-on-startup>2</load-on-startup>
    </servlet>
    <servlet>
        <servlet-name>ecomAjax</servlet-name>
        <servlet-class>net.ecom.ajax.ecomAjax</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>UserProfileAjax</servlet-name>
        <servlet-class>net.ecom.ajax.UserProfileAjax</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>CacheIntializationServlet</servlet-name>
        <servlet-class>net.ecom.controller.CacheIntializationServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>VGMServlet</servlet-name>
        <servlet-class>net.ecom.ajax.VGMServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>ebookRoutingDetails</servlet-name>
        <servlet-class>net.ecom.action.ebookRoutingDetails</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>RouteAjax</servlet-name>
        <servlet-class>net.ecom.ajax.RouteAjax</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>BLJasper</servlet-name>
        <servlet-class>net.ecom.action.BLJasper</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>BookingJasper</servlet-name>
        <servlet-class>net.ecom.action.BookingJasper</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>ValidateReg</servlet-name>
        <servlet-class>net.ecom.action.ValidateReg</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>PortListAjax</servlet-name>
        <servlet-class>net.ecom.ajax.PortListAjax</servlet-class>
    </servlet>
  
    <servlet>
        <servlet-name>CarbonScheduleAjax</servlet-name>
        <servlet-class>net.ecom.carbon.CarbonScheduleAjax</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>VesselInformation</servlet-name>
        <servlet-class>net.ecom.ExportToExcel.VesselInformation</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>DOPrintServlet</servlet-name>
        <servlet-class>net.ecom.action.DOPrintServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>cpanel</servlet-name>
        <servlet-class>net.ecom.action.AdminAction</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>eadmin</servlet-name>
        <servlet-class>net.ecom.action.AdminAction</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>admin</servlet-name>
        <servlet-class>net.ecom.action.AdminAction</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>ActionExcel</servlet-name>
        <servlet-class>net.ecom.ExportToExcel.ActionExcel</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>ExcelExportImport</servlet-name>
        <servlet-class>net.ecom.ExportToExcel.ExcelExportImport</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>ExcelImportData</servlet-name>
        <servlet-class>net.ecom.ExportToExcel.ExcelImportData</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>ExcelExportBooking</servlet-name>
        <servlet-class>net.ecom.ExportToExcel.ExcelExportBooking</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>ExcelImportBooking</servlet-name>
        <servlet-class>net.ecom.ExportToExcel.ExcelImportBooking</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>Faces Servlet</servlet-name>
        <servlet-class>javax.faces.webapp.FacesServlet</servlet-class>
        <load-on-startup>1</load-on-startup>
    </servlet>
    <servlet>
        <servlet-name>RegistrationAjax</servlet-name>
        <servlet-class>net.ecom.ajax.RegistrationAjax</servlet-class>
        <multipart-config>
            <max-file-size>52428800</max-file-size>
            <max-request-size>52428800</max-request-size>
        </multipart-config>
    </servlet>
    <servlet-mapping>
        <servlet-name>RegistrationAjax</servlet-name>
        <url-pattern>/RegistrationAjax</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>BookingJasper</servlet-name>
        <url-pattern>/BookingJasper</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>ecomAjax</servlet-name>
        <url-pattern>/ecomAjax</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>BLJasper</servlet-name>
        <url-pattern>/BLJasper</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>UserProfileAjax</servlet-name>
        <url-pattern>/UserProfileAjax</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>CacheIntializationServlet</servlet-name>
        <url-pattern>/CacheInti</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>VGMServlet</servlet-name>
        <url-pattern>/VGMServlet</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>ebookRoutingDetails</servlet-name>
        <url-pattern>/ebookRoutingDetails</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>RouteAjax</servlet-name>
        <url-pattern>/RouteAjax</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>ValidateReg</servlet-name>
        <url-pattern>/ValidateReg</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>PortListAjax</servlet-name>
        <url-pattern>/PortListAjax</url-pattern>
    </servlet-mapping>

    <servlet-mapping>
        <servlet-name>CarbonScheduleAjax</servlet-name>
        <url-pattern>/CarbonScheduleAjax</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>VesselInformation</servlet-name>
        <url-pattern>/VesselInformation</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>DOPrintServlet</servlet-name>
        <url-pattern>/DOPrintServlet</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>cpanel</servlet-name>
        <url-pattern>/cpanel</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>eadmin</servlet-name>
        <url-pattern>/eadmin</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>admin</servlet-name>
        <url-pattern>/admin</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>ActionExcel</servlet-name>
        <url-pattern>/ActionExcel</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>ExcelExportImport</servlet-name>
        <url-pattern>/ExcelExportImport</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>ExcelImportData</servlet-name>
        <url-pattern>/ExcelImportData</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>ExcelExportBooking</servlet-name>
        <url-pattern>/ExcelExportBooking</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>ExcelImportBooking</servlet-name>
        <url-pattern>/ExcelImportBooking</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>action</servlet-name>
        <url-pattern>*.do</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>Faces Servlet</servlet-name>
        <url-pattern>/faces/*</url-pattern>
    </servlet-mapping>
    <session-config>
        <tracking-mode>COOKIE</tracking-mode>
        <cookie-config>
            <http-only>true</http-only>
            <secure>true</secure>
        </cookie-config>
        <session-timeout>
            30
        </session-timeout>
    </session-config>
    <welcome-file-list>
        <welcome-file>faces/index.xhtml</welcome-file>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>
    <filter>
        <filter-name>SecurityFilter</filter-name>
        <filter-class>net.ecom.filters.SecurityFilter</filter-class>
        <init-param>
            <param-name>excludedPaths</param-name>
            <param-value>/stripeWebhook.do,/ngeniusWebhook.do</param-value>
        </init-param>
    </filter>
    <filter-mapping>
        <filter-name>SecurityFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>
<!-- Add for Platform Analytics By Prakash Mani-->
    <filter>
        <filter-name>AnalyticsFilter</filter-name>
        <filter-class>net.ecom.filters.AnalyticsFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>AnalyticsFilter</filter-name>
        <url-pattern>/*</url-pattern>
        <dispatcher>REQUEST</dispatcher>
        <dispatcher>FORWARD</dispatcher>
    </filter-mapping>
    <jsp-config>
        <taglib>
            <taglib-uri>/WEB-INF/struts-bean.tld</taglib-uri>
            <taglib-location>/WEB-INF/struts-bean.tld</taglib-location>
        </taglib>
        <taglib>
            <taglib-uri>/WEB-INF/struts-html.tld</taglib-uri>
            <taglib-location>/WEB-INF/struts-html.tld</taglib-location>
        </taglib>
        <taglib>
            <taglib-uri>/WEB-INF/struts-logic.tld</taglib-uri>
            <taglib-location>/WEB-INF/struts-logic.tld</taglib-location>
        </taglib>
        <taglib>
            <taglib-uri>/WEB-INF/struts-nested.tld</taglib-uri>
            <taglib-location>/WEB-INF/struts-nested.tld</taglib-location>
        </taglib>
        <taglib>
            <taglib-uri>/WEB-INF/struts-tiles.tld</taglib-uri>
            <taglib-location>/WEB-INF/struts-tiles.tld</taglib-location>
        </taglib>
    </jsp-config>
</web-app>
